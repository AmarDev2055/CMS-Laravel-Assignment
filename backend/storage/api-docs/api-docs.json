        "/api/pages": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "List pages",
                "description": "Returns a paginated list of pages. Supports search, status filter, menu filter, and pagination.",
                "operationId": "374d995436029ca3d249e45ee40dcd70",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search term matched against page title/body",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "about"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter by page status",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "draft",
                                "published"
                            ]
                        }
                    },
                    {
                        "name": "menu_id",
                        "in": "query",
                        "description": "Filter by menu ID",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of results per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A paginated list of pages"
                    }
                }
            },
            "post": {
                "tags": [
                    "Pages"
                ],
                "summary": "Create a page",
                "operationId": "a6584a2336ff5430afc72ba1058c4b92",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "menu_id",
                                    "title",
                                    "body",
                                    "status"
                                ],
                                "properties": {
                                    "menu_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "About Us"
                                    },
                                    "body": {
                                        "type": "string",
                                        "example": "This is our about page."
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "draft",
                                        "enum": [
                                            "draft",
                                            "published"
                                        ]
                                    },
                                    "publish_date": {
                                        "type": "string",
                                        "format": "date-time",
                                        "nullable": true
                                    },
                                    "cover_image": {
                                        "type": "string",
                                        "format": "binary",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Page created successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
